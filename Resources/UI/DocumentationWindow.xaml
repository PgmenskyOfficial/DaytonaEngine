<Window x:Class="DaytonaEngine.Resources.UI.DocumentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Menu_Documentation}" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" Background="#FF1E1E1E"
        Foreground="#FFDCDCDC">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
            <!-- Title -->
            <TextBlock Text="{DynamicResource Menu_Documentation}" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

            <!-- Work in Progress text -->
            <TextBlock Text="{DynamicResource Doc_WorkInProgress}" FontSize="13" Foreground="#FFDCDCDC"/>
        </StackPanel>
    </Grid>
</Window>