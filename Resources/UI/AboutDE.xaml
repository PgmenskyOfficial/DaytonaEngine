<Window x:Class="DaytonaEngine.Resources.UI.AboutDE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutTitle}" Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="White">
        
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek tekstowy -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="DaytonaEngine Editor" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource AboutVersion}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Opis -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="13"
           Text="{DynamicResource AboutDescription}" Foreground="White"/>

        <!-- Przycisk Zamknij -->
        <!-- Przycisk Zamknij -->
        <Button Grid.Row="2" Content="{DynamicResource AboutClose}" Width="100" HorizontalAlignment="Center" Click="CloseButton_Click" Margin="0,10,0,0"
        Background="#2D2D2D" Foreground="White" BorderBrush="#555555"/>
    </Grid>
</Window>