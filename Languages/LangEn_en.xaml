<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Main Tabs -->
    <sys:String x:Key="Menu_Project">Project</sys:String>
    <sys:String x:Key="Menu_Edit">Edit</sys:String>
    <sys:String x:Key="Menu_Tools">Tools</sys:String>
    <sys:String x:Key="Menu_View">View</sys:String>
    <sys:String x:Key="Menu_Help">Help</sys:String>

    <!-- Groups & Buttons -->
    <sys:String x:Key="Group_File">File</sys:String>
    <sys:String x:Key="Menu_New">New</sys:String>
    <sys:String x:Key="Menu_Open">Open</sys:String>
    <sys:String x:Key="Menu_Save">Save</sys:String>
    <sys:String x:Key="Menu_Recent">Recent</sys:String>
    
    <sys:String x:Key="Group_Clipboard">Clipboard</sys:String>
    <sys:String x:Key="Menu_Cut">Cut</sys:String>
    <sys:String x:Key="Menu_Copy">Copy</sys:String>
    <sys:String x:Key="Menu_Paste">Paste</sys:String>

    <sys:String x:Key="Group_Options">Options</sys:String>
    <sys:String x:Key="Menu_Settings">Settings</sys:String>

    <sys:String x:Key="Group_Panels">Panels</sys:String>
    <sys:String x:Key="Menu_Hierarchy">Hierarchy</sys:String>
    <sys:String x:Key="Menu_Properties">Properties</sys:String>

    <sys:String x:Key="Group_Info">Information</sys:String>
    <sys:String x:Key="Menu_Documentation">Documentation</sys:String>
    <sys:String x:Key="Menu_About">About</sys:String>
    <sys:String x:Key="Menu_binary">Binary</sys:String>
    <!-- Splash Screen -->
    <sys:String x:Key="Splash_Title">Loading DaytonaEngine</sys:String>
    <sys:String x:Key="Splash_Init">Initializing editor environment...</sys:String>
    <sys:String x:Key="Splash_Version">Beta Version</sys:String>
    <!-- ABOUT SCREEN -->
    <sys:String x:Key="AboutTitle">About - DaytonaEngine</sys:String>
    <sys:String x:Key="AboutVersion">Version Beta</sys:String>
    <sys:String x:Key="AboutDescription">DaytonaEngine is an Open Source Editor. All rights reserved © 2026.</sys:String>
    <sys:String x:Key="AboutClose">Close</sys:String>
    <!-- Settings -->
    <sys:String x:Key="Settings_Title">Settings</sys:String>
    <sys:String x:Key="Tab_General">General</sys:String>
    <sys:String x:Key="Tab_Editor">Editor</sys:String>
    <sys:String x:Key="Label_Language">Application Language:</sys:String>
    <sys:String x:Key="Check_AutoSave">Enable project auto-save</sys:String>
    <sys:String x:Key="Label_FontSize">Editor font size:</sys:String>
    <sys:String x:Key="Btn_Save">Save</sys:String>
    <sys:String x:Key="Btn_Cancel">Cancel</sys:String>
    <!-- NEW OPEN SAVE -->
    <sys:String x:Key="Msg_NewProject">Do you want to create a new project? Unsaved changes will be lost.</sys:String>
    <sys:String x:Key="Msg_NewTitle">New Project</sys:String>
    <sys:String x:Key="Msg_Error">Error</sys:String>
    <sys:String x:Key="Msg_OpenError">Failed to open file:</sys:String>
    <sys:String x:Key="Msg_SaveError">Failed to save file:</sys:String>
    <!-- DATA PROTECTION / CLOSING -->
    <sys:String x:Key="Msg_UnsavedChanges">You have unsaved changes. Do you want to save them before exiting?</sys:String>
    <sys:String x:Key="Msg_WarningTitle">Unsaved Changes</sys:String>
    <!-- Doc -->
    <sys:String x:Key="Doc_WorkInProgress">Work In Progress</sys:String>
    <!-- INPUT BOX -->
    <sys:String x:Key="RenameTitle">Rename</sys:String>
    <sys:String x:Key="RenamePromptText">Enter new name:</sys:String>
    <sys:String x:Key="BtnOK">OK</sys:String>
    <sys:String x:Key="BtnCancel">Cancel</sys:String>

    <sys:String x:Key="Ctx_AddItem">Add item...</sys:String>
    <sys:String x:Key="Ctx_Rename">Rename (F2)</sys:String>
    <sys:String x:Key="Ctx_Delete">Delete</sys:String>
</ResourceDictionary>