<Fluent:RibbonWindow x:Class="DaytonaEngine.DE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DaytonaEngine"
        xmlns:Fluent="clr-namespace:Fluent;assembly=Fluent"
        mc:Ignorable="d"
        Title="DaytonaEngine Editor" Height="720" Width="1280"
        Icon="pack://application:,,,/Resources/DE_LOGO_16X.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Górna wstążka -->
            <RowDefinition Height="Auto"/>
            <!-- Główna zawartość edytora -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. WSTĄŻKA (Ribbon) -->
        <Fluent:Ribbon Grid.Row="0">

            <!-- Zakładka Projekt -->
            <Fluent:RibbonTabItem Header="{DynamicResource Menu_Project}">
                <Fluent:RibbonGroupBox Header="{DynamicResource Group_File}">
                    <Fluent:Button Header="{DynamicResource Menu_New}" SizeDefinition="Large" Click="New_Click" />
                    <Fluent:Button Header="{DynamicResource Menu_Open}" SizeDefinition="Middle" Click="Open_Click" />
                    <Fluent:Button Header="{DynamicResource Menu_Save}" SizeDefinition="Middle" Click="Save_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Zakładka Edycja -->
            <Fluent:RibbonTabItem Header="{DynamicResource Menu_Edit}">
                <Fluent:RibbonGroupBox Header="{DynamicResource Group_Clipboard}">
                    <Fluent:Button Header="{DynamicResource Menu_Cut}" Click="Cut_Click" SizeDefinition="Middle" />
                    <Fluent:Button Header="{DynamicResource Menu_Copy}" Click="Copy_Click" SizeDefinition="Middle" />
                    <Fluent:Button Header="{DynamicResource Menu_Paste}" Click="Paste_Click" SizeDefinition="Middle" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Zakładka Narzędzia -->
            <Fluent:RibbonTabItem Header="{DynamicResource Menu_Tools}">
                <Fluent:RibbonGroupBox Header="{DynamicResource Group_Options}">
                    <!-- TUTAJ DODANO Click="MenuSettings_Click" -->
                    <Fluent:Button Header="{DynamicResource Menu_Settings}" SizeDefinition="Large" Click="MenuSettings_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Zakładka Widok -->
            <Fluent:RibbonTabItem Header="{DynamicResource Menu_View}">
                <Fluent:RibbonGroupBox Header="{DynamicResource Group_Panels}">
                    <Fluent:ToggleButton x:Name="BtnHierarchy" Header="{DynamicResource Menu_Hierarchy}" IsChecked="True" SizeDefinition="Large"
                             Checked="BtnHierarchy_Checked" Unchecked="BtnHierarchy_Unchecked" />
                    <Fluent:ToggleButton x:Name="BtnProperties" Header="{DynamicResource Menu_Properties}" IsChecked="True" SizeDefinition="Large"
                             Checked="BtnProperties_Checked" Unchecked="BtnProperties_Unchecked"  />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <!-- Zakładka Pomoc -->
            <Fluent:RibbonTabItem Header="{DynamicResource Menu_Help}">
                <Fluent:RibbonGroupBox Header="{DynamicResource Group_Info}">
                    <Fluent:Button Header="{DynamicResource Menu_Documentation}" SizeDefinition="Large" Click="MenuDocumentation_Click" />
                    <Fluent:Button Header="{DynamicResource Menu_About}" SizeDefinition="Middle" Click="MenuAbout_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

        </Fluent:Ribbon>


        <!-- 2. UKŁAD EDYTORA (3 Kolumny: Hierarchia | Kod Binarny | Właściwości) -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Lewy panel: Hierarchia -->
            <Border x:Name="HierarchyPanel" Grid.Column="0" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="1" Margin="2">
                <TextBlock Text="{DynamicResource Menu_Hierarchy}" Foreground="White" Margin="8,5" FontSize="11" FontWeight="Bold"/>
            </Border>

            <!-- Środkowy panel: Podgląd Kodu Binarnego -->
            <Border Grid.Column="1" Background="#FF1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="1" Margin="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource Menu_binary}" Foreground="White" Margin="8,5" FontSize="11" FontWeight="Bold"/>

                    <TextBox Grid.Row="1" Background="#FF1E1E1E" Foreground="#FFDCDCDC" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="NoWrap" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="5"
                             Text=" "/>
                </Grid>
            </Border>

            <!-- Prawy panel: Właściwości -->
            <Border x:Name="PropertiesPanel" Grid.Column="2" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="1" Margin="2">
                <TextBlock Text="{DynamicResource Menu_Properties}" Foreground="White" Margin="8,5" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>

    </Grid>
</Fluent:RibbonWindow>